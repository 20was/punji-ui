    "@playwright/test": "1.64.1",
    "@size-limit/preset-small-lib": "14.2.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "lightningcss": "1.33.0",
    "lockfile-lint": "5.1.0",
    "oxlint": "1.88.0",
    "playwright": "1.64.1",

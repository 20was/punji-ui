  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "lint": "oxlint --max-warnings 0 --deny-warnings src test scripts examples portal site fixtures playwright.config.ts && node scripts/check-css.mjs && node scripts/check-contrast.mjs && node scripts/check-source.mjs && node scripts/check-boundaries.mjs && node scripts/check-changesets.mjs",
    "sync": "node scripts/sync-from-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:deep": "FC_NUM_RUNS=2000 vitest run",
    "size": "size-limit",
    "check:publint": "publint --strict",
    "check:types": "attw --pack . --profile esm-only --exclude-entrypoints styles.css tokens.css \"css/*.css\" package.json",
    "check:package": "npm run check:publint && npm run check:types && node scripts/check-pack.mjs && npm run check:exports",
    "check:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https --validate-integrity",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size && npm run check:package && npm run build:examples && npm run typecheck:examples && npm run typecheck:portal && npm run typecheck:visual && npm run typecheck:site && npm run test:apps && npm run site:build && npm run check:seo && npm run check:examples",
    "verify:deep": "npm run verify && npm run test:deep",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "echo \"Publishing runs only in .github/workflows/release.yml (publish job)\" && exit 1",
    "audit:web": "node scripts/audit-web.mjs",
    "examples": "vite examples --host 127.0.0.1",
    "build:examples": "vite build examples",
    "prepack": "npm run build",
    "check:exports": "node scripts/check-exports.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "typecheck:examples": "tsc -p examples/tsconfig.json --noEmit",
    "check:examples": "node scripts/check-examples.mjs",
    "portal": "npm run build && node scripts/portal.mjs",
    "typecheck:portal": "tsc -p portal/tsconfig.json --noEmit",
    "check:portal": "node scripts/check-portal.mjs",
    "check:calendar": "node scripts/check-calendar.mjs",
    "check:fields": "node scripts/check-fields.mjs",
    "check:select": "node scripts/check-select.mjs",
    "check:table": "node scripts/check-table.mjs",
    "visual:serve": "npm run build && vite build test/visual && vite preview test/visual",
    "test:visual": "playwright test",
    "test:visual:docker": "node scripts/visual-docker.mjs",
    "test:visual:update": "node scripts/visual-docker.mjs --update-snapshots",
    "typecheck:visual": "tsc -p test/visual/tsconfig.json --noEmit",
    "site:gen": "node scripts/site-gen.mjs",
    "site:dev": "npm run build && npm run site:gen && vite site",
    "site:build": "npm run site:gen && vite build site && vite build site --ssr src/entry-server.tsx --outDir dist-server && node scripts/site-prerender.mjs && node scripts/site-registry.mjs",
    "site:preview": "vite preview site",
    "typecheck:site": "npm run site:gen && tsc -p site/tsconfig.json --noEmit",
    "check:site": "node scripts/check-site.mjs",
    "check:seo": "node scripts/check-seo.mjs && node scripts/check-registry.mjs",
    "site:brand": "node scripts/site-brand.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check:nextjs": "node scripts/check-nextjs.mjs",
    "dev": "node scripts/dev.mjs",
    "bench:table": "node scripts/bench-table.mjs",
    "bench:charts": "node scripts/bench-charts.mjs",
    "test:apps": "vitest run --config vitest.apps.config.ts",
    "check:registry": "node scripts/check-registry.mjs",
    "check:templates": "node scripts/check-templates.mjs",
    "new:component": "node scripts/new-component.mjs"
  },

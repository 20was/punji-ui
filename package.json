{
  "name": "@punji/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Accessible, tree-shakeable React components themed with CSS variables, with light and dark modes and Devanagari-ready type.",
  "license": "MIT",
  "author": "Punji",
  "homepage": "https://design.punji.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/20was/punji-ui.git"
  },
  "bugs": "https://github.com/20was/punji-ui/issues",
  "keywords": [
    "react",
    "design-system",
    "ui",
    "components",
    "accessibility",
    "css-variables",
    "dark-mode",
    "devanagari",
    "nepali"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/Button.d.ts",
      "default": "./dist/button/Button.js"
    },
    "./card": {
      "types": "./dist/card/Card.d.ts",
      "default": "./dist/card/Card.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/Checkbox.d.ts",
      "default": "./dist/checkbox/Checkbox.js"
    },
    "./choice-group": {
      "types": "./dist/choice-group/ChoiceGroup.d.ts",
      "default": "./dist/choice-group/ChoiceGroup.js"
    },
    "./command-palette": {
      "types": "./dist/command-palette/CommandPalette.d.ts",
      "default": "./dist/command-palette/CommandPalette.js"
    },
    "./company-search": {
      "types": "./dist/company-search/CompanySearch.d.ts",
      "default": "./dist/company-search/CompanySearch.js"
    },
    "./controls": {
      "types": "./dist/controls/Controls.d.ts",
      "default": "./dist/controls/Controls.js"
    },
    "./drawer": {
      "types": "./dist/drawer/Drawer.d.ts",
      "default": "./dist/drawer/Drawer.js"
    },
    "./fields": {
      "types": "./dist/fields/Fields.d.ts",
      "default": "./dist/fields/Fields.js"
    },
    "./floating-tooltip": {
      "types": "./dist/floating-tooltip/FloatingTooltip.d.ts",
      "default": "./dist/floating-tooltip/FloatingTooltip.js"
    },
    "./info-tip": {
      "types": "./dist/info-tip/InfoTip.d.ts",
      "default": "./dist/info-tip/InfoTip.js"
    },
    "./inline-confirm": {
      "types": "./dist/inline-confirm/InlineConfirm.d.ts",
      "default": "./dist/inline-confirm/InlineConfirm.js"
    },
    "./list-filter": {
      "types": "./dist/list-filter/ListFilter.d.ts",
      "default": "./dist/list-filter/ListFilter.js"
    },
    "./overlay": {
      "types": "./dist/overlay/Overlay.d.ts",
      "default": "./dist/overlay/Overlay.js"
    },
    "./range-slider": {
      "types": "./dist/range-slider/RangeSlider.d.ts",
      "default": "./dist/range-slider/RangeSlider.js"
    },
    "./select": {
      "types": "./dist/select/Select.d.ts",
      "default": "./dist/select/Select.js"
    },
    "./show-more": {
      "types": "./dist/show-more/ShowMore.d.ts",
      "default": "./dist/show-more/ShowMore.js"
    },
    "./states": {
      "types": "./dist/states/States.d.ts",
      "default": "./dist/states/States.js"
    },
    "./status-pill": {
      "types": "./dist/status-pill/StatusPill.d.ts",
      "default": "./dist/status-pill/StatusPill.js"
    },
    "./switch": {
      "types": "./dist/switch/Switch.d.ts",
      "default": "./dist/switch/Switch.js"
    },
    "./tabs": {
      "types": "./dist/tabs/Tabs.d.ts",
      "default": "./dist/tabs/Tabs.js"
    },
    "./command-keys": {
      "types": "./dist/command-keys/commandKeys.d.ts",
      "default": "./dist/command-keys/commandKeys.js"
    },
    "./format": {
      "types": "./dist/format/format.d.ts",
      "default": "./dist/format/format.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./css/*.css": "./dist/css/*.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "lint": "oxlint --max-warnings 0 --deny-warnings src test scripts && node scripts/check-css.mjs && node scripts/check-source.mjs",
    "sync": "node scripts/sync-from-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "size": "size-limit",
    "check:publint": "publint --strict",
    "check:types": "attw --pack . --profile esm-only --exclude-entrypoints styles.css tokens.css \"css/*.css\" package.json",
    "check:package": "npm run check:publint && npm run check:types && node scripts/check-pack.mjs",
    "check:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https --validate-integrity",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size && npm run check:package",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "npm run build && changeset publish"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@size-limit/preset-small-lib": "14.2.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "lightningcss": "1.33.0",
    "lockfile-lint": "5.1.0",
    "oxlint": "1.88.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "size-limit": "14.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
